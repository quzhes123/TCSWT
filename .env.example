# Anthropic 配置（直连或公司网关二选一）
# 直连：
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# 公司/代理网关（你当前环境就是这种）：
ANTHROPIC_BASE_URL=https://aiapi.tcredit.com
ANTHROPIC_AUTH_TOKEN=your-gateway-token

# 调研模型（按需切换）
ANTHROPIC_MODEL=claude-opus-4-8

# ===== 受控搜索（让 web 调研真正生效）=====
# 推荐：Tavily（LLM 友好，1000 次/月免费，注册无需信用卡）
# 注册：https://tavily.com → API Keys → 复制 tvly-... 粘到下面
TAVILY_API_KEY=

# 备选：SerpAPI（通用搜索代理，免费 100 次/月）
# 注册：https://serpapi.com
SERPAPI_API_KEY=
SERPAPI_ENGINE=google

# 显式指定 provider（留空则按 key 自动选 tavily > serpapi）
# 可选值：tavily | serpapi
SEARCH_PROVIDER=

# 服务端口
PORT=8787

# 单批最多客户数（保护配额）
MAX_CUSTOMERS_PER_BATCH=50

# 单字段并发（控成本/限速）
FIELD_CONCURRENCY=4
